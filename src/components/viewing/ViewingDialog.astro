---
import { budgetOptions } from '@/config/lead-form';
import type { ProductId } from '@/content/products';
interface Props { product?: ProductId; }
const { product } = Astro.props;
---
<dialog data-product={product} id="viewing-dialog" aria-labelledby="viewing-title">
 <button class="close" aria-label="Закрити форму" data-viewing-close>✕</button>
 <p class="dialog-kicker">Stone Village</p>
 <h2 id="viewing-title">Записатись<br />на перегляд</h2>
 <p class="form-intro">Залиште контакти — менеджер зателефонує, відповість на питання й узгодить зручний час.</p>
 <p class="offer-context" hidden></p>
 <form><input type="hidden" name="offer" value="" />
  <div class="fields"><label for="lead-name">Ім’я</label><input id="lead-name" name="name" autocomplete="given-name" required minlength="2" maxlength="80" placeholder="Як до вас звертатися" />
  <label for="lead-phone">Телефон</label><input id="lead-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="24" placeholder="+380" aria-describedby="phone-error"/><p id="phone-error" class="field-error" hidden>Вкажіть повний номер телефону з кодом країни.</p>
  <fieldset><legend>Який будинок розглядаєте?</legend><div class="choices"><label><input type="radio" name="product" value="duplex-185" required/><span>Дуплекс 185 м²</span></label><label><input type="radio" name="product" value="cottage-228"/><span>Котедж 228 м²</span></label><label><input type="radio" name="product" value="undecided" checked/><span>Ще обираю</span></label></div></fieldset>
  {budgetOptions.length>0&&<><label for="lead-budget">Бюджет на придбання</label><select id="lead-budget" name="budget" required><option value="">Оберіть діапазон</option>{budgetOptions.map(option=><option>{option}</option>)}</select></>}
  <label class="consent"><input type="checkbox" name="consent" required/><span>Погоджуюся, щоб зі мною зв’язалися щодо перегляду.</span></label>
  <button class="cta submit" type="submit">Записатись на перегляд <span aria-hidden="true">↗</span></button></div>
  <p class="form-status" role="status" aria-live="polite" tabindex="-1" hidden></p>
 </form>
</dialog>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('#viewing-dialog')!;
 const form=dialog.querySelector<HTMLFormElement>('form')!;
 const phone=form.querySelector<HTMLInputElement>('[name=phone]')!;
 const phoneError=form.querySelector<HTMLElement>('#phone-error')!;
 const status=form.querySelector<HTMLElement>('.form-status')!;
 let returnFocus:HTMLElement|null=null;

 document.querySelectorAll<HTMLButtonElement>('[data-viewing-open]').forEach(button=>button.addEventListener('click',()=>{
  returnFocus=button.closest('#navigation-dialog')?document.querySelector('.menu-trigger'):button;
  status.hidden=true;
  const offerContext=dialog.querySelector<HTMLElement>('.offer-context')!;
  offerContext.hidden=!button.dataset.offer;
  offerContext.textContent=button.dataset.offerLabel ?? '';
  form.querySelector<HTMLInputElement>('[name=offer]')!.value=button.dataset.offer ?? '';
  const product=button.closest('#duplex-185')?'duplex-185':button.closest('#cottage-228')?'cottage-228':dialog.dataset.product;
  if(product)form.querySelector<HTMLInputElement>(`[value="${product}"]`)!.checked=true;
  dialog.showModal();
 }));
 dialog.querySelector('[data-viewing-close]')!.addEventListener('click',()=>dialog.close());
 dialog.addEventListener('close',()=>returnFocus?.focus({preventScroll:true}));
 phone.addEventListener('input',()=>{phone.setCustomValidity('');phone.removeAttribute('aria-invalid');phoneError.hidden=true;});
 form.addEventListener('submit',event=>{
  event.preventDefault();
  const digits=phone.value.replace(/\D/g,'');
  const valid=/^0\d{9}$/.test(digits)||/^380\d{9}$/.test(digits)||(/^\+/.test(phone.value.trim())&&digits.length>=10&&digits.length<=15);
  if(!valid){phoneError.hidden=false;phone.setAttribute('aria-invalid','true');phone.setCustomValidity('Перевірте номер телефону');phone.reportValidity();return;}
  const name=form.querySelector<HTMLInputElement>('[name=name]')!;
  if(name.value.trim().length<2){name.setCustomValidity('Вкажіть ім’я');name.reportValidity();name.addEventListener('input',()=>name.setCustomValidity(''),{once:true});return;}
  status.hidden=false;
  status.textContent='Форму заповнено. У цьому попередньому перегляді дані не надсилаються.';status.focus();
 });
</script>
<style>
 .offer-context {font-size:.85rem;border-block:1px solid var(--color-line);padding:.75rem 0;margin-bottom:1rem;}
 dialog {border:0;padding:clamp(1.5rem,4vw,3rem);width:min(560px,calc(100% - 2rem));max-height:calc(100dvh - 2rem);background:var(--color-paper);color:var(--color-ink);overscroll-behavior:contain;} dialog::backdrop {background:rgb(20 18 15 / 70%);} dialog[open] {animation:dialog-in 450ms var(--ease-settle);} @keyframes dialog-in {from {opacity:0;transform:translateY(1.5rem);}} .dialog-kicker {font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--color-accent);margin-bottom:1rem;} .close {position:absolute;right:.6rem;top:.6rem;width:44px;height:44px;border:0;background:none;cursor:pointer;} h2 {font-size:clamp(2.25rem,3.4vw,3rem);line-height:1.02;letter-spacing:-.04em;font-weight:300;} .form-intro {font-size:.9rem;color:var(--color-muted);margin:1rem 0 1.5rem;} .fields {display:grid;gap:.65rem;} .fields>label,legend {font-size:.85rem;} input:not([type=radio]):not([type=checkbox]),select {width:100%;min-height:48px;border:0;border-bottom:1px solid var(--color-line);background:transparent;color:var(--color-ink);padding:.65rem 0;font-size:1rem;border-radius:0;margin-bottom:.5rem;} input[aria-invalid=true] {border-bottom-color:var(--color-error)!important;} fieldset {min-width:0;border:0;padding:0;margin:.6rem 0;} legend {margin-bottom:.75rem;} .choices {display:flex;flex-wrap:wrap;gap:.5rem;} .choices label {position:relative;cursor:pointer;} .choices input {position:absolute;opacity:0;width:1px;height:1px;} .choices span {display:flex;align-items:center;min-height:44px;padding:.65rem .8rem;border:1px solid var(--color-line);font-size:.75rem;} .choices input:checked+span {border-color:var(--color-ink);background:var(--color-ink);color:var(--color-paper);} .choices input:focus-visible+span {outline:2px solid var(--color-focus);outline-offset:3px;} .consent {display:flex;gap:.65rem;align-items:start;line-height:1.5;margin:.5rem 0;} .consent input {width:18px;height:18px;flex-shrink:0;accent-color:var(--color-ink);} .consent span {font-size:.75rem;color:var(--color-muted);} .submit {width:100%;margin-top:.5rem;} .submit:disabled {opacity:.6;cursor:wait;} .form-status {font-size:.9rem;margin-top:1rem;} .field-error {font-size:.75rem;color:var(--color-error);}
 @media(max-width:600px){dialog {padding:2.5rem 1.25rem 1.5rem;} .form-intro {margin-bottom:1rem;} .choices span {font-size:.7rem;padding:.6rem;}}
</style>
