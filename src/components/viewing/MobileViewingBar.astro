---
import { project, salesContact } from '@/content/project';
---
<div class="viewing-bar" data-viewing-bar aria-hidden="true" inert>
  <button class="cta" data-viewing-open>{project.primaryAction}<span aria-hidden="true">↗</span></button>
  <a class="call" href={salesContact.href} aria-label={`Зателефонувати: ${salesContact.label}`}>
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
  </a>
</div>
<script>
  const bar = document.querySelector<HTMLElement>('[data-viewing-bar]')!;
  const stops = document.querySelectorAll('#visit, .site-footer, .residence-offer');
  let pastIntro = false;
  let nearStop = false;
  const render = () => {
    const show = pastIntro && !nearStop;
    bar.classList.toggle('is-shown', show);
    bar.toggleAttribute('inert', !show);
    bar.setAttribute('aria-hidden', String(!show));
  };
  const onScroll = () => { pastIntro = scrollY > innerHeight * .8; render(); };
  const visible = new Set<Element>();
  const io = new IntersectionObserver(entries => {
    entries.forEach(entry => entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target));
    nearStop = visible.size > 0;
    render();
  });
  stops.forEach(stop => io.observe(stop));
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
<style>
  .viewing-bar { display: none; }
  @media (max-width: 48rem) {
    .viewing-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: var(--layer-sticky-cta); display: flex; gap: .5rem; padding: .6rem var(--gutter) calc(.6rem + env(safe-area-inset-bottom)); background: rgb(244 240 232 / 97%); box-shadow: 0 -1px 0 rgb(43 39 35 / 10%); transform: translateY(110%); transition: transform 450ms var(--ease-settle); }
    .viewing-bar.is-shown { transform: none; }
    .viewing-bar .cta { flex: 1; min-width: 0; min-height: 3.25rem; gap: 1rem; padding-inline: 1.1rem; }
    .call { display: grid; place-items: center; flex: 0 0 3.25rem; height: 3.25rem; border: 1px solid var(--color-ink); color: var(--color-ink); }
  }
</style>
