---
import BrandSignature from './BrandSignature.astro';
import { salesContact } from '@/content/project';
interface Props { inner?: boolean; }
const { inner = false } = Astro.props;
const home = inner ? '/' : '';
---
<footer><a href={home + "#home"} class="footer-brand" aria-label="Stone Village — на початок"><BrandSignature /></a><div><p>Відділ продажу</p><a href={salesContact.href}>{salesContact.label}</a></div><nav aria-label="Навігація внизу сторінки"><a href={home + "#homes"}>Будинки</a><a href={home + "#infrastructure"}>Інфраструктура</a><a href={home + "#gallery"}>Галерея</a><a href={home + "#visit-location"}>Розташування</a></nav><p class="copyright">© {new Date().getFullYear()} Stone Village · Stone Development</p></footer>
<style>
 footer { padding:3rem var(--gutter) 1.5rem; display:grid; grid-template-columns:1fr 1fr 1fr; gap:2rem; font-size:.875rem; } .footer-brand { align-self:start; text-decoration:none; letter-spacing:.1em; font-size:1.2rem; } footer nav { display:grid; } footer a { display:inline-flex; align-items:center; min-height:44px; } .copyright { grid-column:1/-1; font-size:.7rem; color:var(--color-muted); border-top:1px solid var(--color-line); padding-top:1.5rem; max-width:none; }

@media(max-width:767px) { footer { grid-template-columns:1fr; } }
</style>
