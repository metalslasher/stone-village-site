---
import BrandSignature from './BrandSignature.astro';
import { project, salesContact } from '@/content/project';
interface Props { inner?: boolean; }
const { inner = false } = Astro.props;
const home = inner ? '/' : '';
const links = [
  { href: '#about', label: 'Про містечко' },
  { href: '#homes', label: 'Будинки' },
  { href: '#infrastructure', label: 'Інфраструктура' },
  { href: '#gallery', label: 'Галерея' },
  { href: '#location', label: 'Розташування' },
];
---
<header class:list={['site-header', { 'is-inner': inner }]} data-header>
  <a class="brand" href={home + '#home'} aria-label="Stone Village — головна">
    <BrandSignature />
  </a>
  <nav aria-label="Головна навігація" class="desktop-nav">
    {links.map(link => <a href={home + link.href}>{link.label}</a>)}
  </nav>
  <a class="header-phone" href={salesContact.href}>{salesContact.label}</a>
  <button class="header-viewing" data-viewing-open>{project.primaryAction}<span aria-hidden="true">↗</span></button>
  <button class="menu-trigger" aria-label="Відкрити меню" aria-haspopup="dialog" aria-controls="navigation-dialog"><span></span><span></span></button>
</header>
<dialog id="navigation-dialog" class="navigation-dialog" aria-labelledby="menu-title">
  <div class="menu-top">
    <p id="menu-title"><BrandSignature /></p>
    <button data-menu-close aria-label="Закрити меню"><span></span><span></span></button>
  </div>
  <nav aria-label="Мобільна навігація">
    {links.map((link, i) => <a href={home + link.href} style={`--i:${i}`}><span>{link.label}</span><small>0{i + 1}</small></a>)}
  </nav>
  <div class="menu-bottom">
    <button class="cta cta--light" data-viewing-open>{project.primaryAction}<span aria-hidden="true">↗</span></button>
    <a class="menu-phone" href={salesContact.href}>{salesContact.label}</a>
  </div>
</dialog>
<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  // Hide after a deliberate downward run, show after a deliberate upward run.
  // Travel is accumulated per direction so small or uneven wheel steps never flip the state.
  const threshold = 48;
  let last = scrollY;
  let travel = 0;
  let hidden = false;
  let queued = false;
  const setHidden = (value: boolean) => {
    if (value === hidden) return;
    hidden = value;
    header.classList.toggle('is-hidden', value);
  };
  const update = () => {
    queued = false;
    const y = Math.max(0, scrollY);
    const delta = y - last;
    last = y;
    header.classList.toggle('is-scrolled', y > 24);
    if (y <= 160 || document.documentElement.matches(':has(dialog[open])')) { travel = 0; setHidden(false); return; }
    if (delta === 0) return;
    travel = Math.sign(delta) === Math.sign(travel) ? travel + delta : delta;
    if (travel > threshold) setHidden(true);
    else if (travel < -threshold) setHidden(false);
  };
  const schedule = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
  update();
  addEventListener('scroll', schedule, { passive: true });
  addEventListener('pageshow', () => { last = scrollY; update(); });
  header.addEventListener('focusin', () => { travel = 0; setHidden(false); });
  const menu = document.querySelector<HTMLDialogElement>('#navigation-dialog')!;
  const trigger = document.querySelector<HTMLButtonElement>('.menu-trigger')!;
  trigger.addEventListener('click', () => menu.showModal());
  menu.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
  menu.querySelectorAll('a, [data-viewing-open]').forEach(link => link.addEventListener('click', () => menu.close()));
</script>
<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: var(--layer-header);
    display: flex; align-items: center; gap: 2rem;
    padding: 1.25rem var(--gutter);
    color: #fbf9f4;
    transition: background-color 300ms ease, color 300ms ease, transform 450ms var(--ease-settle), box-shadow 300ms ease;
    will-change: transform;
  }
  .site-header.is-scrolled { background: rgb(244 240 232 / 96%); color: var(--color-ink); box-shadow: 0 1px 0 rgb(43 39 35 / 8%); }
  .site-header.is-hidden { transform: translateY(-100%); }
  .site-header.is-inner { position: sticky; background: rgb(244 240 232 / 96%); color: var(--color-ink); }
  .brand { margin-inline-end: auto; flex-shrink: 0; text-decoration: none; display: inline-flex; padding-block: .35rem; }
  .desktop-nav { display: flex; gap: 1.75rem; font-size: .8125rem; letter-spacing: .01em; }
  .desktop-nav a { position: relative; text-decoration: none; padding-block: .9rem; }
  .desktop-nav a::after { content: ''; position: absolute; inset: auto 0 .6rem; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: right; transition: transform 400ms var(--ease-settle); }
  .desktop-nav a:hover::after { transform: scaleX(1); transform-origin: left; }
  .header-phone { font-size: .8125rem; text-decoration: none; white-space: nowrap; font-variant-numeric: tabular-nums; min-height: 44px; display: inline-flex; align-items: center; }
  .header-phone:hover { text-decoration: underline; }
  .header-viewing { display: flex; align-items: center; gap: 1.5rem; padding: .8rem 1.2rem; background: transparent; color: inherit; border: 1px solid currentColor; font-size: .8125rem; cursor: pointer; min-height: 44px; transition: background 200ms, color 200ms, border-color 200ms; }
  .header-viewing:hover { background: #fbf9f4; color: var(--color-ink); border-color: #fbf9f4; }
  .is-scrolled .header-viewing, .is-inner .header-viewing { background: var(--color-ink); color: var(--color-paper); border-color: var(--color-ink); }
  .is-scrolled .header-viewing:hover, .is-inner .header-viewing:hover { background: var(--color-accent-hover); border-color: var(--color-accent-hover); color: var(--color-paper); }
  .menu-trigger { display: none; background: none; border: 0; padding: 10px; width: 44px; height: 44px; cursor: pointer; color: inherit; }
  .menu-trigger span { display: block; height: 1.5px; background: currentColor; margin: 7px 0; }
  .menu-trigger span:last-child { width: 65%; margin-left: auto; }
  .site-header :focus-visible { outline-color: currentColor; }

  .navigation-dialog { border: 0; margin: 0; padding: 1rem var(--gutter) 1.5rem; max-width: none; max-height: none; width: 100%; height: 100dvh; background: var(--color-night); color: #fbf9f4; display: none; flex-direction: column; }
  .navigation-dialog[open] { display: flex; animation: menu-in 500ms var(--ease-settle); }
  .navigation-dialog::backdrop { background: rgb(29 27 24 / 60%); }
  .menu-top { display: flex; justify-content: space-between; align-items: center; }
  .menu-top button { position: relative; border: 0; background: none; width: 44px; height: 44px; cursor: pointer; color: inherit; }
  .menu-top button span { position: absolute; left: 11px; right: 11px; top: 50%; height: 1.5px; background: currentColor; transform: rotate(45deg); }
  .menu-top button span + span { transform: rotate(-45deg); }
  .navigation-dialog nav { display: grid; margin-block: auto; padding-block: 2rem; }
  .navigation-dialog nav a { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .9rem 0; border-bottom: 1px solid var(--color-night-line); font-size: clamp(1.75rem, 8vw, 2.75rem); letter-spacing: -.03em; text-decoration: none; animation: menu-link 700ms var(--ease-settle) both; animation-delay: calc(120ms + var(--i) * 50ms); }
  .navigation-dialog nav small { font-size: .75rem; color: var(--color-night-muted); letter-spacing: .1em; }
  .menu-bottom { display: grid; gap: .75rem; }
  .menu-bottom .cta { width: 100%; }
  .menu-phone { display: flex; justify-content: center; align-items: center; min-height: 48px; text-decoration: none; color: var(--color-night-muted); font-size: .9375rem; }
  .navigation-dialog :focus-visible { outline-color: #fbf9f4; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(-1.5rem); } }
  @keyframes menu-link { from { opacity: 0; transform: translateY(1.25rem); } }
  @media (max-width: 86rem) { .header-phone { display: none; } }
  @media (max-width: 74rem) { .desktop-nav { display: none; } .menu-trigger { display: block; } .site-header { gap: 1rem; } }
  @media (max-width: 40rem) { .site-header { padding-block: .9rem; } .header-viewing { display: none; } }
</style>
