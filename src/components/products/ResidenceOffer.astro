---
import { offer, residenceOffer, formatUsd } from '@/content/offer';
import type { ProductId } from '@/content/products';
interface Props { product: ProductId; compact?: boolean; }
const { product, compact = false } = Astro.props;
const { product: house, savingUsd } = residenceOffer(product);
---
{compact ? (
  <div class="offer-badge"><strong>−{offer.discountPerM2Usd}&nbsp;$</strong><span>на кожен м²</span></div>
) : (
  <section id="special-offer" class="residence-offer" aria-labelledby="offer-title">
    <div class="offer-value">
      <h2 id="offer-title">Знижка {offer.discountPerM2Usd}&nbsp;$<br />на кожен м²</h2>
      <p class="saving numeral"><span>−{formatUsd(savingUsd)}</span><small>$</small></p>
    </div>
    <div class="offer-action">
      <p>Огляньте будинок і планування. На перегляді менеджер розрахує вартість з урахуванням акції та розповість про комплектацію.</p>
      <button class="cta cta--light" data-viewing-open data-offer="per-square-metre" data-offer-label={`Акція: −${formatUsd(savingUsd)} $ для ${house.areaM2} м²`}>Записатись на перегляд <span aria-hidden="true">↗</span></button>
      <p class="offer-note">Остаточну вартість і умови придбання уточнюйте у відділі продажу.</p>
    </div>
  </section>
)}
<style>
  .residence-offer { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 3rem var(--grid-gap); padding: var(--space-section) var(--gutter); background: var(--color-accent); color: #fbf9f4; align-items: end; }
  .offer-value { grid-column: 1 / span 7; }
  h2 { font-size: clamp(2.25rem, 4vw, 4.25rem); font-weight: 300; }
  .saving { display: flex; align-items: flex-start; gap: .75rem; margin-top: 2rem; white-space: nowrap; }
  .saving > span { font-size: clamp(4.5rem, 11vw, 11rem); }
  .saving small { font-size: clamp(1.5rem, 3vw, 2.75rem); margin-top: .4em; }
  .offer-action { grid-column: 9 / span 4; }
  .offer-action > p:first-child { font-size: 1.0625rem; color: #f6efe5; }
  .offer-action .cta { margin-top: 1.75rem; width: 100%; }
  .offer-note { margin-top: 1.25rem; font-size: .75rem; color: #efe3d2; }
  .residence-offer :focus-visible { outline-color: #fff; }
  @media (max-width: 64rem) { .offer-value, .offer-action { grid-column: 1 / -1; } .offer-action { max-width: 34rem; } }
  @media (max-width: 48rem) { .residence-offer { display: block; } .offer-action { margin-top: 2rem; } .saving > span { font-size: clamp(3.75rem, 19vw, 6rem); } }

  .offer-badge { position: absolute; right: clamp(1rem, 2vw, 2rem); top: clamp(1rem, 2vw, 2rem); z-index: 2; display: grid; gap: .3rem; padding: 1rem 1.25rem; background: var(--color-accent); color: #fbf9f4; pointer-events: none; }
  .offer-badge strong { font-size: clamp(1.8rem, 3vw, 2.75rem); font-weight: 300; letter-spacing: -.04em; line-height: 1; }
  .offer-badge span { font-size: .8125rem; }
  @media (max-width: 48rem) { .offer-badge { padding: .75rem 1rem; } .offer-badge strong { font-size: 1.75rem; } .offer-badge span { font-size: .75rem; } }
</style>
