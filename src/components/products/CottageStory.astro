---
import { Image } from 'astro:assets';
import garden from '@/assets/products/cottage-garden.jpg';
import { cottage228 } from '@/content/products';

---
<section id="cottage-228" class="cottage-story" aria-labelledby="cottage-title">
  <header><div><h2 id="cottage-title">Окремий<br />котедж</h2></div><p class="cottage-area"><span>{cottage228.areaM2}</span> м²</p></header>
  <figure><Image src={garden} alt="Візуалізація окремого котеджу Stone Village: тераса, приватний двір і варіант облаштування басейну" widths={[640,960,1280,1680]} sizes="100vw" format="webp" loading="lazy" /></figure>
  <div class="cottage-description"><p>Будинок без спільної стіни із сусідами. Ділянка 6,94 сотки, простора тераса та два криті паркомісця.</p><a class="product-page-link" href="/cottage-228/">Детальніше про котедж <span aria-hidden="true">↗</span></a></div>
</section>
<style>
 .product-page-link {display:inline-flex;align-items:center;justify-content:space-between;gap:2rem;min-height:48px;padding:.75rem 0;border-bottom:1px solid currentColor;text-decoration:none;font-size:.95rem;order:7;}

  .cottage-story { padding-top:clamp(3rem,5vw,5rem); }
  header { display:flex; justify-content:space-between; align-items:end; gap:2rem; padding-inline:var(--gutter); margin:0 auto 3rem; max-width:112rem; }
  .label { font-size:.75rem; text-transform:uppercase; letter-spacing:.1em; color:var(--color-muted); margin-bottom:1.5rem; }
  h2 { font-size:clamp(2.5rem,4.6vw,5rem); }
  .cottage-area { white-space:nowrap; font-size:1.75rem; line-height:1; }
  .cottage-area span { font-size:clamp(6rem,13vw,13rem); letter-spacing:-.065em; font-weight:300; }
  figure img { width:100%; height:auto; aspect-ratio:1.95; object-fit:cover; object-position:50% 50%; }

  .cottage-description { display:grid; grid-template-columns:1fr auto; align-items:center; gap:3rem; padding:clamp(2rem,3.5vw,3.5rem) var(--gutter); max-width:112rem; margin:auto; }
  .lead { font-size:clamp(1.8rem,3vw,3rem); line-height:1.2; letter-spacing:-.025em; }
  .cottage-description > div:not(.cottage-choice) > p { color:var(--color-muted); max-width:44ch; }
  dl { margin-block:2rem 1rem; } dl div { display:flex; justify-content:space-between; gap:1.5rem; padding:1rem 0; border-top:1px solid var(--color-line); font-size:.875rem; } dt { color:var(--color-muted); } dd { text-align:right; }
  .cottage-choice button {display:flex;align-items:center;justify-content:space-between;gap:2rem;min-height:52px;padding:1rem 1.3rem;background:var(--color-ink);color:var(--color-paper);border:0;cursor:pointer;font-size:.9rem;margin-top:2rem;}




  @media(max-width:767px) { header { display:block; margin-bottom:2rem; } .cottage-area { margin-top:2rem; } .cottage-area span { font-size:6rem; } figure img { aspect-ratio:1.1; object-position:42% center; } .cottage-description { grid-template-columns:1fr; gap:1.5rem; } }
.cottage-description>p {max-width:54ch;color:var(--color-muted);font-size:1rem;}
</style>
