---
interface Props { product: 'duplex-185' | 'cottage-228'; title: string; }
const { product, title } = Astro.props;
---
<div class="product-plans">
  <button class="plans-trigger" data-plan-open={product} aria-haspopup="dialog" aria-controls={`plans-${product}`}>Переглянути планування <span aria-hidden="true">+</span></button>
  <dialog id={`plans-${product}`} aria-labelledby={`plan-title-${product}`}>
    <header><div><p>Планування будинку</p><h2 id={`plan-title-${product}`}>{title}</h2></div><button data-plan-close aria-label="Закрити планування" autofocus>✕</button></header>
    <div class="floor-controls" role="group" aria-label="Обрати поверх">
      <button data-floor="1" aria-pressed="true">1 поверх</button>
      <button data-floor="2" aria-pressed="false">2 поверх</button>
    </div>
    {[1, 2].map(floor => <figure data-plan-floor={floor} hidden={floor !== 1}>
      <img decoding="async" data-src={`/media/plans/${product}-${floor}.jpg`} alt={`${title}: план ${floor}-го поверху`} />
      <figcaption><a href={`/media/plans/${product}-${floor}.jpg`} target="_blank" rel="noopener">Відкрити оригінал</a></figcaption>
    </figure>)}
    <p class="plan-note">Варіант планування забудовника, опублікований на LUN. Можливість змін обговорюється під час перегляду.</p>
  </dialog>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.product-plans').forEach(root => {
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const trigger = root.querySelector<HTMLButtonElement>('[data-plan-open]')!;
    const loadFloor = (floor: string) => {
      root.querySelectorAll<HTMLElement>('[data-plan-floor]').forEach(figure => {
        figure.hidden = figure.dataset.planFloor !== floor;
        if (!figure.hidden) {
          const img = figure.querySelector<HTMLImageElement>('img')!;
          if (!img.hasAttribute('src')) img.src = img.dataset.src!;
        }
      });
      root.querySelectorAll<HTMLButtonElement>('[data-floor]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.floor === floor)));
    };
    trigger.addEventListener('click', () => { loadFloor('1'); dialog.showModal(); });
    root.querySelector('[data-plan-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => trigger.focus({ preventScroll:true }));
    dialog.addEventListener('click', event => { if (event.target !== dialog) return; const r=dialog.getBoundingClientRect(); if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom) dialog.close(); });
    root.querySelectorAll<HTMLButtonElement>('[data-floor]').forEach(button => button.addEventListener('click', () => loadFloor(button.dataset.floor!)));
  });
</script>
<style>
  .plans-trigger { display:flex; justify-content:space-between; align-items:center; gap:2rem; padding:1rem 0; background:none; border:0; border-bottom:1px solid currentColor; cursor:pointer; min-height:44px; }
  .plans-trigger:hover { color:var(--color-accent); }
  .plans-trigger span { font-size:1.5rem; }
  dialog { width:min(52rem,calc(100% - 2rem)); max-height:90dvh; padding:2rem; border:0; color:var(--color-ink); background:var(--color-paper); overscroll-behavior:contain; }
  dialog::backdrop { background:rgb(30 27 23 / 75%); }
  header { display:flex; justify-content:space-between; gap:1rem; align-items:start; }
  header p,.plan-note { font-size:.75rem; color:var(--color-muted); }
  h2 { font-size:clamp(1.3rem,3vw,2rem); margin-top:.5rem; }
  header button { width:44px; height:44px; border:0; background:none; cursor:pointer; flex-shrink:0; }
  .floor-controls { display:flex; gap:1rem; margin-block:1.5rem; }
  .floor-controls button { min-height:44px; padding:.6rem 1rem; background:none; border:1px solid var(--color-line); cursor:pointer; }
  .floor-controls button[aria-pressed=true] { background:var(--color-ink); color:var(--color-paper); border-color:var(--color-ink); }
  figure { background:white; padding:1rem; }
  figure img { max-height:60dvh; width:auto; margin:auto; max-width:100%;  object-fit:contain; }
  figcaption { text-align:center; font-size:.8rem; margin-top:1rem; }
  figcaption a { display:inline-flex; min-height:44px; align-items:center; }
  .plan-note { margin-top:1rem; max-width:65ch; }
  @media(max-width:600px) { dialog { padding:1.25rem; } figure { padding:.5rem; } }
</style>
