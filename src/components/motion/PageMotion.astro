---
// Shared motion runtime: reveal on enter, scroll progress for scroll-linked scenes,
// number counters. Everything is static and readable without it or with reduced motion.
---
<script>
 const root=document.documentElement;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');

 // Reveal on enter.
 const reveal=new IntersectionObserver(entries=>{
  for(const entry of entries){
   if(!entry.isIntersecting)continue;
   entry.target.classList.add('is-visible');
   reveal.unobserve(entry.target);
  }
 },{threshold:.12,rootMargin:'0px 0px -6% 0px'});
 document.querySelectorAll('[data-reveal]').forEach(el=>reveal.observe(el));

 // Scroll progress 0..1 written to --progress.
 // data-progress="sticky": the element is a tall runway whose child is position:sticky.
 // data-progress="pass": progress while the element travels through the viewport.
 // data-progress="exit": 0 at the top of the page, 1 once the element has scrolled away.
 // data-progress="enter": 0 when the top edge enters, 1 once one viewport of it is visible.
 const tracked=Array.from(document.querySelectorAll<HTMLElement>('[data-progress]'));
 const active=new Set<HTMLElement>();
 const io=new IntersectionObserver(entries=>{
  for(const entry of entries){
   if(entry.isIntersecting)active.add(entry.target as HTMLElement);else active.delete(entry.target as HTMLElement);
  }
  schedule();
 },{rootMargin:'20% 0px'});
 tracked.forEach(el=>io.observe(el));
 let queued=false;
 const clamp=(v:number)=>Math.min(1,Math.max(0,v));
 function paint(){
  queued=false;
  const vh=innerHeight;
  for(const el of active){
   const rect=el.getBoundingClientRect();
   const mode=el.dataset.progress;
   const value=mode==='sticky'?clamp(-rect.top/Math.max(1,rect.height-vh))
    :mode==='exit'?clamp(-rect.top/Math.max(1,rect.height))
    :mode==='enter'?clamp((vh-rect.top)/Math.max(1,Math.min(rect.height,vh)))
    :clamp((vh-rect.top)/(rect.height+vh));
   el.style.setProperty('--progress',value.toFixed(4));
   el.dispatchEvent(new CustomEvent('progress',{detail:value}));
  }
 }
 function schedule(){if(!queued){queued=true;requestAnimationFrame(paint);}}
 addEventListener('scroll',schedule,{passive:true});
 addEventListener('resize',schedule);
 const settle=()=>{
  if(reduced.matches)tracked.forEach(el=>el.style.setProperty('--progress','1'));
  else schedule();
 };
 reduced.addEventListener('change',()=>{root.classList.toggle('motion',!reduced.matches);settle();});
 settle();

 // Counters: final value stays in the markup; the animation only replays it.
 const format=(value:number,decimals:number)=>value.toFixed(decimals).replace('.',',');
 const counters=new IntersectionObserver(entries=>{
  for(const entry of entries){
   if(!entry.isIntersecting)continue;
   counters.unobserve(entry.target);
   if(reduced.matches)continue;
   const el=entry.target as HTMLElement;
   const text=el.textContent??'';
   const target=parseFloat(text.replace(',','.'));
   if(!Number.isFinite(target)||target===0)continue;
   const decimals=(text.split(/[.,]/)[1]??'').length;
   const start=performance.now(),duration=1400;
   const step=(now:number)=>{
    const t=Math.min(1,(now-start)/duration);
    const eased=1-Math.pow(1-t,4);
    el.textContent=t<1?format(target*eased,decimals):text;
    if(t<1)requestAnimationFrame(step);
   };
   requestAnimationFrame(step);
  }
 },{threshold:.6});
 document.querySelectorAll('[data-count]').forEach(el=>counters.observe(el));
</script>
