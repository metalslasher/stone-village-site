---
import { Image } from 'astro:assets';
import detail from '@/assets/architecture/facade-detail-april-2024.jpg';
import { duplexSpecs, communityEngineering } from '@/content/construction';
---
<section id="quality" class="quality" aria-labelledby="quality-title">
  <div class="quality-head">
    <p class="kicker">Якість</p>
    <h2 id="quality-title" data-reveal="lines"><span class="line-mask"><span>Що всередині</span></span><span class="line-mask"><span>стін.</span></span></h2>
    <p class="lead" data-reveal>Рішення, від яких залежать тепло, тиша й витрати на утримання дому. Показники нижче — для дуплексів; специфікацію котеджу уточнюйте на перегляді.</p>
  </div>
  <div class="quality-body">
    <figure data-reveal="image">
      <Image src={detail} alt="Архівне фото забудовника, квітень 2024: фасад дуплекса Stone Village з консоллю даху та панорамним вікном" widths={[480, 800, 1200]} sizes="(max-width: 767px) 100vw, 38vw" format="webp" loading="lazy" />
    </figure>
    <div class="specs">
      <dl class="figures">
        {duplexSpecs.map((spec, i) => (
          <div data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <dt class="numeral"><span data-count>{spec.figure}</span><small>{spec.unit}</small></dt>
            <dd><strong>{spec.title}</strong>{spec.text}</dd>
          </div>
        ))}
      </dl>
      <dl class="engineering" data-reveal>
        {communityEngineering.filter(item => item.title !== 'Стан при передачі').map(item => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}
      </dl>
    </div>
  </div>
</section>
<style>
  .quality { padding-block: var(--space-section); }
  .quality-head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem var(--grid-gap); align-items: end; padding-inline: var(--gutter); margin-bottom: clamp(3rem, 6vw, 6rem); }
  .quality-head .kicker { grid-column: 1 / -1; }
  .quality-head h2 { grid-column: 1 / span 6; }
  .lead { grid-column: 8 / span 5; color: var(--color-muted); font-size: 1.0625rem; }
  .quality-body { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--grid-gap); padding-inline: var(--gutter); align-items: start; }
  figure { grid-column: 1 / span 5; position: sticky; top: 6rem; overflow: hidden; margin: 0; }
  figure img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; }
  .specs { grid-column: 7 / span 6; }
  .figures { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--grid-gap); }
  .figures > div { padding-bottom: 3rem; }
  .figures dt { font-size: clamp(3.75rem, 6.5vw, 7rem); }
  .figures dt small { font-size: 1rem; letter-spacing: 0; margin-left: .5rem; font-weight: 400; color: var(--color-muted); }
  .figures dd { margin-top: 1.25rem; color: var(--color-muted); font-size: .9375rem; max-width: 30ch; }
  .figures strong { display: block; font-weight: 500; color: var(--color-ink); font-size: 1.0625rem; margin-bottom: .35rem; }
  .engineering { margin-top: 1.5rem; }
  .engineering div { display: grid; grid-template-columns: 11rem 1fr; gap: 1.5rem; padding: 1rem 0; border-top: 1px solid var(--color-line); }
  .engineering dt { font-size: .9375rem; }
  .engineering dd { color: var(--color-muted); font-size: .9375rem; }
  @media (max-width: 64rem) {
    .quality-head h2 { grid-column: 1 / -1; }
    .lead { grid-column: 1 / span 9; }
    figure { grid-column: 1 / span 5; }
    .specs { grid-column: 6 / span 7; }
  }
  @media (max-width: 48rem) {
    .quality-head, .quality-body { display: block; }
    .lead { margin-top: 1.25rem; font-size: 1rem; }
    figure { position: relative; top: 0; margin-bottom: 2rem; }
    figure img { aspect-ratio: 1 / 1; }
    .figures dt { font-size: 3.25rem; }
    .figures > div { padding-bottom: 1.75rem; }
    .figures dd { font-size: .875rem; }
    .engineering div { grid-template-columns: 1fr; gap: .25rem; }
  }
  @media (max-width: 26rem) {
    .figures { grid-template-columns: 1fr; }
  }
</style>
