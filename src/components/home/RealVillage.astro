---
import { Image } from 'astro:assets';
import winter from '@/assets/proof/winter-duplexes.jpg';
import row from '@/assets/proof/row-by-forest-april-2024.jpg';
import street from '@/assets/proof/street-april-2024.jpg';
import { project } from '@/content/project';
---
<section id="proof" class="proof" aria-labelledby="proof-title">
  <div class="proof-copy">
    <p class="kicker">Реальні фото</p>
    <h2 id="proof-title" data-reveal="lines"><span class="line-mask"><span>Не лише</span></span><span class="line-mask"><span>візуалізації.</span></span></h2>
    <p class="lead" data-reveal>Це архівні фото забудовника: зведені дуплекси, вулиці й ліс за будинками. Як містечко виглядає сьогодні, найкраще побачити наживо.</p>
    <button class="cta" data-viewing-open data-reveal>{project.primaryAction}<span aria-hidden="true">↗</span></button>
  </div>
  <figure class="shot shot--a" data-reveal="image">
    <Image src={row} alt="Архівне фото забудовника, квітень 2024: ряд зведених дуплексів Stone Village на тлі лісу" widths={[480, 800, 1200]} sizes="(max-width: 767px) 100vw, 34vw" format="webp" loading="lazy" />
  </figure>
  <figure class="shot shot--b" data-reveal="image">
    <Image src={winter} alt="Архівне фото забудовника: зведений дуплекс Stone Village взимку, сосни в снігу на передньому плані" widths={[480, 700]} sizes="(max-width: 767px) 70vw, 24vw" format="webp" loading="lazy" />
  </figure>
  <figure class="shot shot--c" data-reveal="image">
    <Image src={street} alt="Архівне фото забудовника, квітень 2024: внутрішня вулиця Stone Village під час будівництва" widths={[480, 800, 1200]} sizes="(max-width: 767px) 60vw, 22vw" format="webp" loading="lazy" />
  </figure>
</section>
<style>
  .proof { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto auto; gap: var(--grid-gap); padding: var(--space-section) var(--gutter); align-items: start; }
  .proof-copy { grid-column: 1 / span 4; grid-row: 1 / span 2; position: sticky; top: 7rem; }
  h2 { margin-top: 1.5rem; }
  .lead { margin: 1.75rem 0 2.25rem; color: var(--color-muted); font-size: 1.0625rem; max-width: 34ch; }
  .shot { margin: 0; overflow: hidden; }
  .shot img { width: 100%; height: 100%; object-fit: cover; }
  .shot--a { grid-column: 6 / span 4; grid-row: 1 / span 2; aspect-ratio: 3 / 4; }
  .shot--b { grid-column: 10 / span 3; grid-row: 1; aspect-ratio: 3 / 4; margin-top: 8rem; }
  .shot--c { grid-column: 10 / span 3; grid-row: 2; aspect-ratio: 1 / 1; }
  @media (max-width: 64rem) {
    .proof-copy { grid-column: 1 / -1; grid-row: auto; position: relative; top: 0; margin-bottom: 2rem; }
    .shot--a { grid-column: 1 / span 7; grid-row: auto; }
    .shot--b { grid-column: 8 / span 5; grid-row: auto; margin-top: 6rem; }
    .shot--c { display: none; }
  }
  @media (max-width: 48rem) {
    .proof { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .75rem; }
    .proof-copy .cta { width: 100%; }
    .shot--a { grid-column: 1 / span 4; }
    .shot--b { grid-column: 3 / span 4; margin-top: -30%; position: relative; z-index: 1; outline: .5rem solid var(--color-paper); }
  }
</style>
