---
import { Image } from 'astro:assets';
import aerial from '@/assets/environment/village-forest.jpg';
---
<figure id="masterplan" data-image-reveal>
 <Image src={aerial} alt="Візуалізація Stone Village з висоти: будинки та подвір’я поруч із лісовим масивом" widths={[640,960,1280,1680]} sizes="100vw" format="webp" loading="lazy"/>
</figure>
<style>figure {overflow:hidden;}img {display:block;width:100%;height:auto;}</style>
