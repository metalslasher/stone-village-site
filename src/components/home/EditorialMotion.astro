<script>
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const active=new Set<Animation>();
 const run=(element:Element,keyframes:Keyframe[],duration:number)=>{
   const animation=element.animate(keyframes,{duration,easing:'cubic-bezier(.22,1,.36,1)'});
   active.add(animation);
   animation.finished.finally(()=>active.delete(animation)).catch(()=>{});
 };
 const headings=document.querySelectorAll('main > section:not(.hero) h2');
 const pictures=document.querySelectorAll('[data-image-reveal], #about > figure, .cottage-story > figure, .proof-scenes figure');
 const observer=new IntersectionObserver(entries=>{
   for(const entry of entries){
     if(!entry.isIntersecting)continue;
     observer.unobserve(entry.target);
     if(reduced.matches)continue;
     if(entry.target.tagName==='H2'){
       run(entry.target,[{opacity:.15,transform:'translateY(28px)'},{opacity:1,transform:'translateY(0)'}],800);
     }else{
       run(entry.target,[{clipPath:'inset(9% 5% 9% 5%)'},{clipPath:'inset(0 0 0 0)'}],1100);
       const img=entry.target.querySelector('img');
       if(img)run(img,[{transform:'scale(1.065)'},{transform:'scale(1)'}],1300);
     }
   }
 },{threshold:.08});
 headings.forEach(el=>observer.observe(el));pictures.forEach(el=>observer.observe(el));
 reduced.addEventListener('change',()=>{if(reduced.matches)active.forEach(animation=>animation.cancel());});
</script>
<style is:global>
 [data-image-reveal], #about > figure, .cottage-story > figure, .proof-scenes figure {overflow:hidden;}
 @media(hover:hover) and (pointer:fine) {
   button[data-viewing-open] {transition:background 180ms ease,color 180ms ease,transform 180ms ease;}
   button[data-viewing-open]:active {transform:scale(.98);}
   button[data-viewing-open] > span {transition:transform 220ms cubic-bezier(.22,1,.36,1);}
   button[data-viewing-open]:hover > span {transform:translate(3px,-3px);}
 }
</style>
