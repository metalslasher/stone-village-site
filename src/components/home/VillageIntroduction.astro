---
import { Image } from 'astro:assets';
import { environment } from '@/content/environment';
---
<section id="about" class="village-introduction" aria-labelledby="village-title">
 <figure><Image src={environment.street} alt="Візуалізація будинків Stone Village з приватними подвір’ями" widths={[480,768,1120,1680]} sizes="(max-width:767px) 100vw, 58vw" format="webp" loading="lazy"/></figure>
 <div class="introduction-copy"><h2 id="village-title">Власний двір.<br />Тераса. Кабінет.</h2><p>Місце для сімейних вечерь надворі та окрема кімната для роботи. У будинку можна розділити спільний час і особисті справи.</p><a href="#homes">Обрати будинок <span aria-hidden="true">↓</span></a></div>
</section>
<style>
.village-introduction {max-width:var(--page-max);margin:auto;display:grid;grid-template-columns:1.4fr 1fr;align-items:center;gap:clamp(2rem,5vw,5rem);padding:clamp(3rem,5vw,5.5rem) var(--gutter);}
figure {overflow:hidden;} figure img {width:100%;aspect-ratio:1.4;object-fit:cover;object-position:55% center;} h2 {font-size:clamp(2.3rem,3.6vw,4rem);max-width:17ch;} p {max-width:34ch;color:var(--color-muted);margin-top:1.5rem;} a {display:inline-flex;align-items:center;gap:2rem;min-height:44px;margin-top:1.5rem;text-decoration:none;border-bottom:1px solid var(--color-line);font-size:.9rem;}
@media(max-width:767px){.village-introduction {grid-template-columns:1fr;gap:1.75rem;padding-block:2.5rem 3rem;} .introduction-copy {grid-row:1;} h2 {font-size:clamp(2rem,8vw,2.75rem);} p {margin-top:1rem;} a {margin-top:.75rem;} figure {margin-inline:calc(-1 * var(--gutter));} figure img {aspect-ratio:1.25;} }
</style>
