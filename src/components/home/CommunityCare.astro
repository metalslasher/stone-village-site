---
import { Image } from 'astro:assets';
import entrance from '@/assets/infrastructure/village-entrance.jpg';
import { care } from '@/content/care';
---
<section id="care" class="care" aria-labelledby="care-title">
  <div class="care-grid">
    <div class="care-copy">
      <p class="kicker">Безпека й догляд</p>
      <h2 id="care-title" data-reveal="lines"><span class="line-mask"><span>Про територію</span></span><span class="line-mask"><span>дбають. Ви —</span></span><span class="line-mask"><span>просто живете.</span></span></h2>
      <p class="lead" data-reveal>Власний будинок без клопоту окремої садиби: спільним простором опікується керуюча компанія.</p>
    </div>
    <figure data-reveal="image">
      <Image src={entrance} alt="Візуалізація забудовника: в’їзд до Stone Village зі шлагбаумом і вулиця з двоповерховими будинками" widths={[640, 960, 1400]} sizes="(max-width: 767px) 100vw, 50vw" format="webp" loading="lazy" />
    </figure>
  </div>
  <dl class="care-list">
    {care.map((item, i) => (
      <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
        <dt><span class="index">0{i + 1}</span>{item.title}</dt>
        <dd>{item.text}</dd>
      </div>
    ))}
  </dl>
</section>
<style>
  .care { padding-block: var(--space-section); background: var(--color-night); color: #fbf9f4; }
  .care .kicker { color: #c8a77f; }
  .care-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--grid-gap); padding-inline: var(--gutter); align-items: center; }
  .care-copy { grid-column: 1 / span 5; }
  h2 { margin-top: 1.5rem; }
  .lead { margin-top: 2rem; color: var(--color-night-muted); font-size: 1.0625rem; max-width: 38ch; }
  figure { grid-column: 7 / span 6; overflow: hidden; margin: 0; }
  figure img { width: 100%; aspect-ratio: 5 / 4; object-fit: cover; object-position: 60% 50%; }
  .care-list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.5rem var(--grid-gap); padding-inline: var(--gutter); margin-top: clamp(3.5rem, 7vw, 6rem); }
  dt { display: flex; flex-direction: column; gap: 1rem; font-size: 1.25rem; letter-spacing: -.02em; margin-bottom: .75rem; }
  .index { font-size: .8125rem; letter-spacing: .12em; color: #c8a77f; }
  dd { color: var(--color-night-muted); font-size: .9375rem; max-width: 30ch; }
  .care :focus-visible { outline-color: #fff; }
  @media (max-width: 64rem) {
    .care-copy { grid-column: 1 / span 12; }
    figure { grid-column: 1 / span 12; margin-top: 2.5rem; }
    .care-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 48rem) {
    .care-grid { display: block; }
    figure { margin-inline: calc(-1 * var(--gutter)); }
    .care-list { grid-template-columns: 1fr; gap: 2rem; }
    dt { flex-direction: row; align-items: baseline; gap: 1rem; }
  }
</style>
