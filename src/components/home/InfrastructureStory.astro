---
import { Image } from 'astro:assets';
import sharedSpaces from '@/assets/infrastructure/shared-spaces.jpg';
import { infrastructure } from '@/content/infrastructure';
---
<section id="infrastructure" class="infrastructure-story" aria-labelledby="infrastructure-title">
  <header class="infrastructure-heading">
    
    <div class="heading-copy">
      <h2 id="infrastructure-title">Для роботи,<br />спорту й відпочинку.</h2>
      <p>Майданчики для дітей, тренування для дорослих і місця, де можна зосередитися на роботі.</p>
    </div>
  </header>
  <figure class="entrance-scene" data-image-reveal>
    <Image src={sharedSpaces} alt="Візуалізація спортивного поля, дитячого майданчика та спільних просторів Stone Village" widths={[640, 960, 1280, 1680]} sizes="(max-width: 767px) 100vw, 92vw" format="webp" loading="lazy" />
    
  </figure>
  <div class="daily-life">
    
    <div class="chapters">
      {infrastructure.chapters.map((chapter, index) => (
        <article class="daily-chapter">
          <span class="chapter-number" aria-hidden="true">0{index + 1}</span>
          <h3>{chapter.title}</h3>
          <div class="chapter-copy">
            <p>{chapter.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .infrastructure-story { max-width:var(--page-max); margin-inline:auto; padding:clamp(3rem,5vw,5rem) var(--gutter) clamp(3rem,5vw,5rem); }
  .chapter-label { font-size:.75rem; letter-spacing:.1em; text-transform:uppercase; color:var(--color-muted); }
  .infrastructure-heading > .chapter-label { margin-bottom:2rem; }
  .heading-copy { display:flex; align-items:end; justify-content:space-between; gap:4rem; }
  h2 { font-size:clamp(2.5rem,4.6vw,5rem); max-width:22ch; }
  .heading-copy > p { max-width:34ch; padding-bottom:.25rem; color:var(--color-muted); }
  .entrance-scene { margin-top:clamp(2.5rem,4vw,4.5rem); }
  .entrance-scene img { width:100%; height:auto; aspect-ratio:2.05; object-fit:cover; object-position:50% 58%; }

  .daily-life { margin-top:clamp(1.5rem,2.5vw,2.5rem); display:grid; grid-template-columns:1fr; gap:3rem; }
  .daily-label { padding-top:1.75rem; }
  .daily-chapter { display:grid; grid-template-columns:2rem 1fr 1.25fr; gap:1.5rem; padding:1.4rem 0; border-top:1px solid var(--color-line); }
  .chapter-number { font-size:.75rem; color:var(--color-muted); padding-top:.25rem; }
  h3 { font-size:clamp(1.35rem,1.9vw,2rem); letter-spacing:-.02em; line-height:1.2; max-width:17ch; }
  .chapter-copy > p:first-child { color:var(--color-muted); font-size:1rem; }
  .chapter-detail { font-size:.75rem; line-height:1.65; margin-top:.6rem; }
  @media(max-width:1100px) {
    .daily-life { grid-template-columns:1fr; gap:1.5rem; }
    .daily-label { padding-top:0; }
    .heading-copy { gap:2rem; }
    .heading-copy > p { max-width:29ch; }
  }
  @media(max-width:767px) {
    .heading-copy { display:block; }
    h2 { font-size:clamp(2.2rem,7.6vw,3.5rem); }
    .heading-copy > p { margin-top:1.5rem; max-width:45ch; }
    .entrance-scene { margin-inline:calc(-1 * var(--gutter)); }
    .entrance-scene img { aspect-ratio:1.15; object-position:61% center; }

    .daily-chapter { grid-template-columns:1.5rem 1fr; gap:.75rem; padding-block:1.75rem; }
    h3 { max-width:none; font-size:1.5rem; }
    .chapter-copy { grid-column:2; }
    .chapter-copy > p:first-child { font-size:.9375rem; }
    .chapter-detail { margin-top:1rem; }
  }
</style>
