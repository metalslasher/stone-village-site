---
import { Image, getImage } from 'astro:assets';
import { infrastructure } from '@/content/infrastructure';
const { chapters } = infrastructure;
const lens = await getImage({ src: infrastructure.image, width: 1280, format: 'webp' });
---
<section id="infrastructure" class="infrastructure" aria-labelledby="infrastructure-title" data-active="0">
  <header class="intro">
    <p class="kicker">Інфраструктура</p>
    <h2 id="infrastructure-title" data-reveal="lines"><span class="line-mask"><span>Щоденне життя —</span></span><span class="line-mask"><span>в межах містечка.</span></span></h2>
    <p class="lead" data-reveal>Садочок, спорт, робоче місце й кава поруч із домом. Менше поїздок — більше часу для своїх.</p>
  </header>
  <div class="scene">
    <figure class="camera" aria-hidden="true">
      <Image src={infrastructure.image} alt="" widths={[960, 1400, 1680]} sizes="(max-width: 767px) 100vw, 58vw" format="webp" loading="lazy" />
    </figure>
    <ol class="chapters">
      {chapters.map((chapter, i) => (
        <li data-chapter={i} data-focus={chapter.focus} data-zoom={chapter.scale} style={`--focus:${chapter.focus};--zoom:${chapter.scale}`}>
          <div class="lens" style={`background-image:url(${lens.src})`} aria-hidden="true"></div>
          <span class="index">0{i + 1}</span>
          <h3>{chapter.title}</h3>
          <p>{chapter.text}</p>
        </li>
      ))}
    </ol>
  </div>
  <p class="visually-hidden">{infrastructure.alt}</p>
</section>
<script>
  const section = document.querySelector<HTMLElement>("#infrastructure")!;
  const camera = section.querySelector<HTMLElement>(".camera")!;
  const img = camera.querySelector<HTMLImageElement>("img")!;
  const items = Array.from(section.querySelectorAll<HTMLElement>("[data-chapter]"));
  let current = items[0]!;
  // Frame the focus point (percent of the full picture) at the requested zoom,
  // clamped so the picture always covers the frame. Only transform animates.
  const frame = () => {
    const w = camera.clientWidth, h = camera.clientHeight;
    if (!w || !h) return;
    const ratio = (img.naturalWidth || 1680) / (img.naturalHeight || 972);
    const coverW = Math.max(w, h * ratio), coverH = coverW / ratio;
    img.style.width = coverW + "px";
    img.style.height = coverH + "px";
    const [fx, fy] = (current.dataset.focus ?? "50% 50%").split(" ").map(v => parseFloat(v) / 100);
    const zoom = parseFloat(current.dataset.zoom ?? "1");
    const clamp = (v: number, min: number) => Math.min(0, Math.max(min, v));
    const x = clamp(w / 2 - fx! * coverW * zoom, w - coverW * zoom);
    const y = clamp(h / 2 - fy! * coverH * zoom, h - coverH * zoom);
    img.style.transform = `translate3d(${x}px, ${y}px, 0) scale(${zoom})`;
  };
  const activate = (item: HTMLElement) => {
    current = item;
    items.forEach(el => el.classList.toggle("is-active", el === item));
    frame();
  };
  activate(current);
  img.addEventListener("load", frame);
  new ResizeObserver(frame).observe(camera);
  // The chapter crossing the middle band of the viewport drives the camera.
  const observer = new IntersectionObserver(entries => {
    for (const entry of entries) if (entry.isIntersecting) activate(entry.target as HTMLElement);
  }, { rootMargin: "-45% 0px -45% 0px" });
  items.forEach(item => observer.observe(item));
</script>
<style>
  .infrastructure { padding-block: var(--space-section); background: var(--color-stone); }
  .intro { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 1.5rem var(--grid-gap); align-items: end; padding-inline: var(--gutter); margin-bottom: clamp(2.5rem, 5vw, 5rem); }
  .intro .kicker { grid-column: 1 / -1; }
  .intro h2 { grid-column: 1 / span 7; }
  .lead { grid-column: 9 / span 4; color: var(--color-muted); font-size: 1.0625rem; }
  .scene { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--grid-gap); padding-inline: var(--gutter); }
  .camera { grid-column: 1 / span 7; position: sticky; top: 12vh; height: 76vh; overflow: hidden; margin: 0; background: #cfd3c6; }
  .camera img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; max-width: none; object-fit: cover; transform-origin: 0 0; transition: transform 1.4s var(--ease-cinema); will-change: transform; }
  .chapters { grid-column: 9 / span 4; list-style: none; margin: 0; padding: 0; }
  .chapters li { min-height: 76vh; display: flex; flex-direction: column; justify-content: center; border-top: 1px solid var(--color-line); opacity: .35; transition: opacity 600ms var(--ease-settle); }
  .chapters li:first-child { border-top: 0; }
  .chapters li.is-active { opacity: 1; }
  .index { font-size: .8125rem; letter-spacing: .12em; color: var(--color-accent); }
  h3 { font-size: clamp(2rem, 3vw, 3.25rem); margin: 1rem 0 1.25rem; }
  .chapters p { color: var(--color-muted); font-size: 1.0625rem; max-width: 36ch; }
  .lens { display: none; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 64rem) {
    .intro h2 { grid-column: 1 / -1; }
    .lead { grid-column: 1 / span 9; }
    .scene { display: block; }
    .camera { display: none; }
    .chapters li { min-height: 0; opacity: 1; padding: 2rem 0 2.5rem; border-top: 0; }
    .lens { display: block; aspect-ratio: 4 / 3; margin: 0 calc(-1 * var(--gutter)) 1.5rem; background-size: calc(var(--zoom) * 100%) auto; background-position: var(--focus); background-repeat: no-repeat; background-color: #cfd3c6; }
    .chapters li:last-child .lens { background-size: cover; background-position: center; }
  }
  @media (max-width: 48rem) {
    .intro, .lead { display: block; }
    .intro h2 { margin-top: 1.25rem; }
    .lead { margin-top: 1.25rem; font-size: 1rem; }
    .lens { aspect-ratio: 1 / 1; background-size: calc(var(--zoom) * 180%) auto; }
  }
</style>
