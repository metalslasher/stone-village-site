---
import { Image } from 'astro:assets';
import street from '@/assets/environment/village-street.jpg';
import { project, salesContact, salesOffice } from '@/content/project';
const steps = [
  { title: 'Заявка', text: 'Ім’я й телефон — це хвилина.' },
  { title: 'Дзвінок', text: 'Менеджер узгодить зручний день і час.' },
  { title: 'Прогулянка', text: 'Вулиці, будинки, ділянки й ліс — наживо.' },
];
---
<section id="visit" class="visit" aria-labelledby="visit-title">
  <figure class="visit-media" data-progress="pass">
    <Image src={street} alt="Візуалізація забудовника: вулиця Stone Village з дуплексами, паркомісцями й перехожими" widths={[768, 1280, 1680]} sizes="100vw" format="webp" loading="lazy" />
  </figure>
  <div class="visit-body">
    <div class="visit-copy">
      <p class="kicker">Перегляд</p>
      <h2 id="visit-title" data-reveal="lines"><span class="line-mask"><span>Приїжджайте</span></span><span class="line-mask"><span>подивитися.</span></span></h2>
      <p class="lead" data-reveal>Фото не передадуть тиші після міста й відчуття власного двору. Покажемо будинки, планування й ділянки та відповімо на всі питання.</p>
      <div class="actions" data-reveal>
        <button class="cta cta--light" data-viewing-open>{project.primaryAction}<span aria-hidden="true">↗</span></button>
        <a class="arrow-link" href={salesContact.href}>або зателефонуйте: {salesContact.label}</a>
      </div>
    </div>
    <ol class="steps">
      {steps.map((step, i) => (
        <li data-reveal style={`--reveal-delay:${i * 120}ms`}>
          <span class="index">0{i + 1}</span>
          <strong>{step.title}</strong>
          <span>{step.text}</span>
        </li>
      ))}
    </ol>
  </div>
  <p class="developer">Девелопер — <a href={salesOffice.developerUrl} target="_blank" rel="noopener">{project.developer}</a>. Відділ продажу: {salesOffice.address}.</p>
</section>
<style>
  .visit { position: relative; color: #fbf9f4; background: var(--color-night); overflow: hidden; }
  .visit-media { --progress: .5; position: absolute; inset: 0; margin: 0; }
  .visit-media img { width: 100%; height: 115%; object-fit: cover; object-position: 50% 60%; }
  :global(.motion) .visit-media img { transform: translateY(calc(-6.5% + (var(--progress) - .5) * -12%)); }
  .visit-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(18 17 15 / 88%) 0%, rgb(18 17 15 / 70%) 45%, rgb(18 17 15 / 35%) 100%); }
  .visit-body { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--grid-gap); align-items: end; padding: clamp(6rem, 14vw, 12rem) var(--gutter) clamp(3rem, 6vw, 5rem); min-height: min(100vh, 58rem); }
  .visit .kicker { color: #d7bb97; }
  .visit-copy { grid-column: 1 / span 6; }
  h2 { margin-top: 1.25rem; font-size: clamp(3rem, 7vw, 8rem); font-weight: 300; letter-spacing: -.055em; line-height: .96; }
  .lead { margin-top: 2rem; color: #e8e2d6; font-size: 1.125rem; max-width: 40ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; margin-top: 2.5rem; }
  .actions .arrow-link { color: #fbf9f4; font-variant-numeric: tabular-nums; }
  .steps { grid-column: 9 / span 4; list-style: none; margin: 0; padding: 0; }
  .steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: .25rem 1rem; padding: 1.25rem 0; border-top: 1px solid rgb(251 249 244 / 25%); }
  .index { grid-row: span 2; font-size: .8125rem; color: #d7bb97; padding-top: .25rem; }
  .steps strong { font-weight: 500; font-size: 1.25rem; letter-spacing: -.02em; }
  .steps li > span:last-child { color: #d9d2c5; font-size: .9375rem; }
  .developer { position: relative; padding: 1.25rem var(--gutter) 1.5rem; border-top: 1px solid rgb(251 249 244 / 18%); font-size: .8125rem; color: #cfc7b9; max-width: none; }
  .visit :focus-visible { outline-color: #fff; }
  @media (max-width: 64rem) {
    .visit-copy { grid-column: 1 / -1; }
    .steps { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--grid-gap); margin-top: 2rem; }
  }
  @media (max-width: 48rem) {
    .visit-media::after { background: linear-gradient(0deg, rgb(18 17 15 / 92%) 35%, rgb(18 17 15 / 55%) 100%); }
    .visit-body { display: block; min-height: 0; padding-top: 8rem; }
    h2 { font-size: clamp(2.75rem, 13vw, 4rem); }
    .lead { font-size: 1rem; }
    .actions .cta { width: 100%; }
    .steps { display: block; }
  }
</style>
