---
import { Image } from 'astro:assets';
import { project } from '@/content/project';
import street from '@/assets/environment/evening-street.jpg';
---
<section class="developer" aria-labelledby="developer-title">
 <p>Девелопер проєкту</p><h2 id="developer-title">Stone Development</h2><a href="https://stonedevelopment.com.ua/" target="_blank" rel="noopener noreferrer">Про забудовника <span aria-hidden="true">↗</span></a>
</section>
<section id="viewing" class="closing" aria-labelledby="closing-title">
 <div class="closing-copy"><h2 id="closing-title">Побачимося<br />у Stone Village.</h2><p>Огляньте будинки й подвір’я, пройдіться вулицями та оберіть формат для своєї сім’ї.</p><button data-viewing-open>{project.primaryAction}<span aria-hidden="true">↗</span></button></div>
 <figure data-image-reveal><Image src={street} alt="Візуалізація вулиці Stone Village з будинками, подвір’ями та вечірнім підсвічуванням фасадів" widths={[640,960,1280,1680]} sizes="(max-width:767px) 100vw, 55vw" format="webp" loading="lazy"/></figure>
</section>
<style>
 .developer {display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:2.5rem var(--gutter);}
 .developer>p {font-size:.75rem;color:var(--color-muted);} .developer h2 {font-size:clamp(1.5rem,2.7vw,3rem);}
 .developer a {display:inline-flex;gap:1.5rem;align-items:center;min-height:44px;font-size:.85rem;text-decoration:none;}
 .closing {display:grid;grid-template-columns:1fr 1.15fr;background:var(--color-ink);color:var(--color-paper);}
 .closing-copy {padding:clamp(3rem,5vw,5rem) var(--gutter);display:flex;flex-direction:column;align-items:start;justify-content:center;min-height:540px;}
 h2 {font-size:clamp(2.3rem,3.7vw,4.5rem);}
 .closing-copy>p {max-width:32ch;font-size:1rem;color:#e2dcd1;margin:1.5rem 0 2rem;}
 .closing button {display:flex;justify-content:space-between;align-items:center;gap:2rem;min-height:52px;padding:1rem 1.5rem;background:var(--color-paper);color:var(--color-ink);border:0;cursor:pointer;font-size:.9rem;}
 .closing button:hover {background:var(--color-stone);}
 .closing :focus-visible {outline-color:white;}
 figure {position:relative;overflow:hidden;} img {position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:40% center;}
 @media(max-width:1000px){.developer {flex-wrap:wrap;}.developer>p {flex-basis:100%;}.closing-copy {min-height:470px;}.closing button {gap:1rem;padding:1rem;}}
 @media(max-width:767px){.developer {gap:.5rem 1rem;padding-block:2rem;}.developer h2 {font-size:1.6rem;}.developer a {font-size:.75rem;}.closing {grid-template-columns:1fr;}.closing-copy {min-height:0;padding-block:2.5rem;} figure {aspect-ratio:1.4;} h2 {font-size:clamp(2.5rem,8vw,3.5rem);}.closing-copy>p {font-size:.9375rem;}.closing button {width:100%;}}
</style>
