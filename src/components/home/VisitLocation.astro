---
import { location, nearbyRoutes } from '@/content/location';
const longest = Math.max(...nearbyRoutes.map(route => route.minutes));
---
<section id="location" class="location" aria-labelledby="location-title">
  <header>
    <div>
      <p class="kicker">Розташування</p>
      <h2 id="location-title" data-reveal="lines"><span class="line-mask"><span>Львів — у звичному</span></span><span class="line-mask"><span>маршруті.</span></span></h2>
      <p class="address">{location.address}, Львівська область</p>
    </div>
    <p class="distance" data-reveal><span class="numeral"><span data-count>2,5</span></span><span>км<br />від Львова</span></p>
  </header>
  <p class="lead" data-reveal>Школа, супермаркет і METRO — за кілька хвилин, центр міста — в межах пів години. Офіс, зустрічі, театр увечері — місто залишається частиною вашого тижня.</p>
  <ol class="routes" data-progress="pass" style={`--max:${longest}`}>
    {nearbyRoutes.map(route => (
      <li style={`--m:${route.minutes}`}>
        <span class="bar" aria-hidden="true"></span>
        <span class="name">{route.title}</span>
        <span class="time"><span class="numeral">{route.minutes}</span> хв</span>
      </li>
    ))}
  </ol>
  <div class="route-actions">
    <p>Орієнтовний час з презентації проєкту. Залежить від транспорту та дорожньої ситуації.</p>
    <div>
      <button class="arrow-link map-toggle" aria-expanded="false" aria-controls="location-map" hidden>Показати карту <span aria-hidden="true">+</span></button>
      <a class="arrow-link" href={location.directionsUrl} target="_blank" rel="noopener noreferrer">Прокласти маршрут <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div id="location-map" hidden><iframe title="Розташування Stone Village, Конопниця" data-src={location.embedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
</section>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.map-toggle')!;
  const map = document.querySelector<HTMLElement>('#location-map')!;
  toggle.hidden = false;
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    map.hidden = !open;
    toggle.innerHTML = open ? 'Сховати карту <span aria-hidden="true">−</span>' : 'Показати карту <span aria-hidden="true">+</span>';
    const frame = map.querySelector('iframe')!;
    if (open && !frame.hasAttribute('src')) frame.src = frame.dataset.src!;
  });
</script>
<style>
  .location { padding: var(--space-section) var(--gutter); background: var(--color-stone); }
  header { display: flex; align-items: flex-end; justify-content: space-between; gap: 3rem; }
  h2 { margin-top: 1.25rem; }
  .address { font-size: .9375rem; color: var(--color-muted); margin-top: 1.5rem; }
  .distance { display: flex; align-items: flex-end; gap: 1.25rem; white-space: nowrap; }
  .distance .numeral { font-size: clamp(6rem, 13vw, 13rem); }
  .distance > span:last-child { font-size: 1rem; line-height: 1.45; padding-bottom: 1.5rem; }
  .lead { margin: clamp(2rem, 4vw, 3.5rem) 0 clamp(2rem, 4vw, 3rem); font-size: clamp(1.125rem, 1.4vw, 1.375rem); max-width: 52ch; line-height: 1.5; }
  .routes { --progress: 1; list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--color-line); }
  .routes li { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 1rem; padding: .85rem 0; border-bottom: 1px solid var(--color-line); }
  .bar { position: absolute; left: 0; bottom: -1px; height: 2px; width: calc(var(--m) / var(--max) * 100%); background: var(--color-accent); transform-origin: left; }
  :global(.motion) .bar { transform: scaleX(clamp(0, calc((var(--progress) - .15) * 2.2), 1)); }
  .name { font-size: 1rem; }
  .time { font-size: .8125rem; color: var(--color-muted); white-space: nowrap; }
  .time .numeral { font-size: 1.75rem; color: var(--color-ink); letter-spacing: -.04em; }
  .route-actions { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding-top: 1.25rem; }
  .route-actions > p { max-width: 46ch; font-size: .8125rem; color: var(--color-muted); }
  .route-actions > div { display: flex; gap: 2.5rem; }
  #location-map { margin-top: 1.5rem; }
  iframe { display: block; width: 100%; height: clamp(320px, 38vw, 540px); border: 0; background: var(--color-paper); filter: grayscale(.35) contrast(1.02); }
  @media (min-width: 64rem) {
    .routes { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--grid-gap); border-top: 0; }
    .routes li:nth-child(-n+2) { border-top: 1px solid var(--color-line); }
  }
  @media (max-width: 48rem) {
    header { display: block; }
    .distance { margin-top: 1.75rem; }
    .distance .numeral { font-size: 6rem; }
    .distance > span:last-child { padding-bottom: .75rem; }
    .route-actions { flex-direction: column; align-items: flex-start; gap: .5rem; }
    .route-actions > div { width: 100%; justify-content: space-between; gap: 1rem; }
  }
</style>
