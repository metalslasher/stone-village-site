---
// Scroll-linked statement: each word brightens as the reader moves through the runway.
// Facts live in their own sections below; this block only sets the idea.
const statement = 'Коли квартира стає тісною, не обов’язково вибирати між простором і Львовом. Тут у кожного своя кімната, у дітей — двір, у вас — тераса й тиша після роботи, а ліс починається там, де закінчується вулиця.';
const words = statement.split(' ');
---
<section id="about" class="statement" aria-labelledby="about-title">
  <div class="runway" data-progress="sticky" style={`--n:${words.length}`}>
    <div class="stage">
      <p class="kicker" id="about-title">Про містечко</p>
      <p class="words">
        {words.map((word, i) => <span style={`--i:${i}`}>{word} </span>)}
      </p>
    </div>
  </div>
</section>
<style>
  .statement { padding-block: var(--space-section); }
  .runway { --progress: 1; position: relative; }
  :global(.motion) .statement { padding-block: 0; }
  :global(.motion) .runway { --progress: 0; height: 200vh; }
  .stage { padding-inline: var(--gutter); }
  :global(.motion) .stage { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; justify-content: center; }
  .kicker { margin-bottom: clamp(1.5rem, 3vw, 2.5rem); }
  .words { max-width: 22em; font-size: clamp(1.9rem, 1rem + 3.3vw, 4.4rem); line-height: 1.12; letter-spacing: -.035em; font-weight: 400; text-wrap: pretty; }
  .words span { color: var(--color-ink); }
  :global(.motion) .words span { opacity: clamp(.16, calc((var(--progress) * 1.25 * var(--n) - var(--i)) / 3), 1); transition: opacity 120ms linear; }
  @media (max-width: 40rem) {
    :global(.motion) .runway { height: 170vh; }
    .words { font-size: clamp(1.65rem, 7.2vw, 2.4rem); line-height: 1.16; }
  }
</style>
