---
import { Image } from 'astro:assets';
import SiteDocument from '@/layouts/SiteDocument.astro';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import SiteFooter from '@/components/navigation/SiteFooter.astro';
import ViewingDialog from '@/components/viewing/ViewingDialog.astro';
import EditorialMotion from '@/components/home/EditorialMotion.astro';
import ResidencePlan from '@/components/products/ResidencePlan.astro';
import ResidenceOffer from '@/components/products/ResidenceOffer.astro';
import garden from '@/assets/products/cottage-garden.jpg';
import duplex from '@/assets/products/duplex-terrace.jpg';
import '@/styles/residences.css';
---
<SiteDocument title="Окремий котедж 228 м² — Stone Village" description="Окремий котедж Stone Village: 228 м², ділянка 6,94 сотки, тераси, безпечна кімната в плануванні та критий паркінг. Перегляньте будинок і його поверхи." noindex>
 <SiteHeader inner />
 <main id="main" tabindex="-1" class="residence cottage-residence">
  <section class="cottage-opening" aria-labelledby="cottage-page-title">
   <a class="back-link" href="/#homes">← Усі будинки</a>
   <header><h1 id="cottage-page-title">Окремий котедж</h1><p class="opening-area">228 <small>м²</small></p></header>
   <figure><ResidenceOffer product="cottage-228" compact /><Image src={garden} alt="Візуалізація окремого котеджу Stone Village з терасою та варіантом облаштування приватного подвір’я" widths={[640,960,1280,1680]} sizes="100vw" format="webp" loading="eager" fetchpriority="high"/></figure>
   <div class="cottage-intro"><p>Власний будинок без спільної стіни із сусідами. Простір для сім’ї всередині й особиста територія навколо.</p><button class="residence-cta" data-viewing-open>Записатись на перегляд <span aria-hidden="true">↗</span></button><a class="text-link" href="#planning">До планування <span aria-hidden="true">↓</span></a></div>
  </section>
  <dl class="residence-facts"><div><dt>Власна ділянка</dt><dd>6,94 <small>сотки</small></dd></div><div><dt>Поверхи</dt><dd>2</dd></div><div><dt>Криті паркомісця</dt><dd>2</dd></div></dl>
  <section class="private-life" aria-labelledby="private-title"><h2 id="private-title">Більше місця<br />поза стінами.</h2><div><p>Тераса для довгих вечерь, сад чи відкрита галявина для дітей. Власну ділянку можна облаштувати відповідно до звичок вашої сім’ї.</p><p>Варіант двору на візуалізації показує можливості простору. Його облаштування визначає ваш проєкт.</p></div></section>
  <ResidencePlan product="cottage-228" />
  <section class="cottage-details" aria-labelledby="cottage-details-title"><h2 id="cottage-details-title">Що варто знати<br />про будинок.</h2><dl>
   <div><dt>Безпечна кімната</dt><dd>Позначена на першому поверсі у варіанті планування забудовника. Її конструкцію та оснащення можна уточнити під час перегляду.</dd></div>
   <div><dt>Інженерія</dt><dd>Індивідуальне опалення, водопостачання зі свердловин і централізована каналізація.</dd></div>
   <div><dt>Оздоблення</dt><dd>Будинок передається з чорновим оздобленням. Інтер’єр ви плануєте під власні потреби.</dd></div>
  </dl></section>
  <aside class="village-link"><p>За межами власної ділянки — спільна інфраструктура й територія під доглядом керуючої компанії.</p><a class="text-link" href="/#care">Про безпеку й обслуговування <span aria-hidden="true">↗</span></a></aside>
  <ResidenceOffer product="cottage-228" />
  <aside class="other-residence"><Image src={duplex} alt="Візуалізація дуплекса Stone Village з боку тераси" widths={[480,800]} sizes="(max-width:767px) 100vw, 30vw" format="webp" loading="lazy"/><div><p>Порівняйте інший формат</p><a href="/duplex-185/">Дуплекс 185 м² <span aria-hidden="true">↗</span></a></div></aside>
 </main>
 <SiteFooter inner /><ViewingDialog product="cottage-228" /><EditorialMotion />
</SiteDocument>
<style>
 .cottage-opening figure {position:relative;}
 .back-link {display:inline-flex;align-items:center;min-height:44px;font-size:.75rem;text-decoration:none;color:var(--color-muted);margin:1rem var(--gutter) 0;}
 .cottage-opening header {padding:1rem var(--gutter) 2rem;display:flex;justify-content:space-between;align-items:center;gap:2rem;}
 h1 {font-size:clamp(2.5rem,5vw,5.5rem);max-width:10ch;font-weight:400;}
 .opening-area {font-size:clamp(6rem,12vw,12rem);font-weight:300;letter-spacing:-.065em;line-height:1;white-space:nowrap;}.opening-area small {font-size:1.75rem;letter-spacing:0;}
 .cottage-opening figure img {width:100%;height:clamp(440px,45vw,740px);object-fit:cover;object-position:50% 52%;}
 .cottage-intro {display:flex;gap:2.5rem;align-items:center;justify-content:space-between;padding:2rem var(--gutter);}
 .cottage-intro>p {max-width:42ch;font-size:1rem;color:var(--color-muted);}.cottage-intro .text-link {font-size:.85rem;}
 .private-life {display:grid;grid-template-columns:1fr 1fr;gap:6vw;align-items:start;padding:2rem var(--gutter) 4rem;}h2 {font-size:clamp(2.3rem,4vw,4.5rem);}
 .private-life p {font-size:1rem;color:var(--color-muted);max-width:45ch;}.private-life p+p {font-size:.8rem;margin-top:1rem;}
 .cottage-details {display:grid;grid-template-columns:1fr 1fr;gap:6vw;padding:clamp(3rem,5vw,5rem) var(--gutter);}
 .cottage-details dl>div {padding:1.1rem 0;border-top:1px solid var(--color-line);}.cottage-details dt {font-size:1.2rem;margin-bottom:.75rem;}.cottage-details dd {font-size:1rem;color:var(--color-muted);max-width:46ch;}
 @media(max-width:1100px){.cottage-intro {flex-wrap:wrap;gap:1rem 2rem;}.cottage-intro>p {max-width:none;flex-basis:100%;}}
 @media(max-width:767px){.back-link {margin-top:.25rem;}.cottage-opening header {align-items:start;flex-direction:column;gap:1rem;padding-top:.75rem;}h1 {font-size:2.8rem;max-width:none;}.opening-area {font-size:6rem;}.cottage-opening figure img {height:430px;object-position:42% center;}.cottage-intro {padding-block:1.5rem;}.cottage-intro .residence-cta {width:100%;}.private-life,.cottage-details {grid-template-columns:1fr;gap:1.5rem;}.private-life {padding-top:1rem;padding-bottom:3rem;}h2 {font-size:2.4rem;}}
</style>
