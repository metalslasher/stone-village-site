---
import { Image } from 'astro:assets';
import SiteDocument from '@/layouts/SiteDocument.astro';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import SiteFooter from '@/components/navigation/SiteFooter.astro';
import ViewingDialog from '@/components/viewing/ViewingDialog.astro';
import MobileViewingBar from '@/components/viewing/MobileViewingBar.astro';
import ResidencePlan from '@/components/products/ResidencePlan.astro';
import ResidenceOffer from '@/components/products/ResidenceOffer.astro';
import garden from '@/assets/products/cottage-garden.jpg';
import aerial from '@/assets/products/cottage-aerial.jpg';
import yard from '@/assets/products/cottage-yard.jpg';
import carport from '@/assets/products/cottage-carport.jpg';
import evening from '@/assets/products/cottage-evening.jpg';
import duplex from '@/assets/products/duplex-terrace.jpg';
import stairs from '@/assets/interiors/living-stairs.jpg';
import bedroom from '@/assets/interiors/bedroom.jpg';
import kids from '@/assets/interiors/kids-room.jpg';
import { communityEngineering } from '@/content/construction';
import { cottage228 } from '@/content/products';
import { project } from '@/content/project';
import '@/styles/residences.css';
const levels = [
  { value: '68', unit: 'м²', title: 'Кухня, їдальня, вітальня', text: 'Один світлий простір на першому поверсі, де вся родина разом — і ще є місце для гостей.' },
  { value: '19,5', unit: 'м²', title: 'Тераса біля вітальні', text: 'Продовження дому надворі: обід у тіні, дитячі ігри на газоні перед очима.' },
  { value: '34', unit: 'м²', title: 'Тераса нагорі', text: 'Відкрита тераса другого поверху — ранкова кава, вечірнє світло й тиша над садом.' },
];
const cottageDetails = [
  { title: 'Безпечна кімната', text: 'Позначена на першому поверсі у плануванні забудовника. Конструкцію та оснащення детально покажемо на перегляді.' },
  { title: 'Вікна REHAU', text: 'Великі площини скління й вихід на терасу з’єднують дім із садом.' },
];
---
<SiteDocument title="Окремий котедж 228 м² — Stone Village" description="Окремий котедж 228 м² у Stone Village біля Львова: ділянка 6,94 сотки, 68 м² кухні-вітальні, тераса 34 м² нагорі, безпечна кімната й критий паркінг. Знижка 50 $ на кожен м²." noindex>
  <SiteHeader inner />
  <main id="main" tabindex="-1" class="residence cottage-residence">
    <section id="cottage-228" class="opening" aria-labelledby="cottage-page-title">
      <div class="opening-head">
        <a class="back-link" href="/#homes"><span aria-hidden="true">←</span> Усі будинки</a>
        <div class="title-row">
          <h1 id="cottage-page-title" data-reveal="lines"><span class="line-mask"><span>Окремий</span></span><span class="line-mask"><span>котедж</span></span></h1>
          <p class="area numeral" data-reveal aria-hidden="true">228<small>м²</small></p>
        </div>
      </div>
      <figure class="opening-media" data-progress="exit">
        <ResidenceOffer product="cottage-228" compact />
        <Image src={garden} alt="Візуалізація забудовника: окремий котедж Stone Village з терасою та приватним двором; басейн — варіант облаштування ділянки" widths={[768, 1280, 1680]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
      </figure>
      <div class="opening-intro">
        <p data-reveal>Власний дім без жодної спільної стіни — простір для великої родини всередині й особиста територія навколо.</p>
        <div class="opening-actions" data-reveal>
          <button class="cta" data-viewing-open>{project.primaryAction}<span aria-hidden="true">↗</span></button>
          <a class="arrow-link" href="#planning">Дивитися планування <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <dl class="residence-facts">
      <div><dt>Власна ділянка</dt><dd>6,94<small>сотки</small></dd></div>
      <div><dt>Поверхи</dt><dd>2</dd></div>
      <div><dt>Окремі кімнати</dt><dd>4</dd></div>
      <div><dt>Критий паркінг</dt><dd>2<small>авто</small></dd></div>
    </dl>

    <section class="rarity" aria-labelledby="rarity-title">
      <figure data-reveal="image"><Image src={aerial} alt="Візуалізація забудовника: окремі котеджі Stone Village згори — будинки, дворики й газони на власних ділянках" widths={[640, 960, 1280]} sizes="(max-width: 767px) 100vw, 55vw" format="webp" loading="lazy" /></figure>
      <div class="rarity-copy">
        <p class="rarity-count"><span class="numeral">{cottage228.masterplanCount}</span><span>окремих котеджів<br />у генплані містечка</span></p>
        <h2 id="rarity-title" data-reveal>Рідкісний формат із найбільшими ділянками.</h2>
        <p data-reveal>Сад, дитячий майданчик, місце для барбекю чи басейну — територію навколо дому ви облаштовуєте під себе.</p>
      </div>
    </section>

    <section class="residence-section levels" aria-labelledby="levels-title">
      <header class="residence-head">
        <p class="kicker">Сценарій життя</p>
        <h2 id="levels-title" data-reveal>Дім, у якому не тісно навіть разом.</h2>
        <p data-reveal>Спільне життя — на першому поверсі, приватне — нагорі: дві спальні, кожна з гардеробною та окремим санвузлом.</p>
      </header>
      <ul class="scenarios">
        {levels.map((item, i) => <li data-reveal style={`--reveal-delay:${i * 100}ms`}><span class="numeral">{item.value}<small>{item.unit}</small></span><h3>{item.title}</h3><p>{item.text}</p></li>)}
      </ul>
    </section>

    <section class="yard" aria-labelledby="yard-title" data-progress="pass">
      <figure><Image src={yard} alt="Візуалізація забудовника: огороджений двір окремого котеджу з великим газоном і терасою" widths={[768, 1280]} sizes="100vw" format="webp" loading="lazy" /></figure>
      <div class="yard-copy">
        <h2 id="yard-title">Більше місця — поза стінами.</h2>
        <p>Газон, де діти граються на очах. Грядки, барбекю або просто тиша — ваша земля, ваші правила.</p>
      </div>
    </section>

    <ResidencePlan product="cottage-228" />

    <section class="residence-section details" aria-labelledby="details-title">
      <div class="details-grid">
        <figure data-reveal="image"><Image src={carport} alt="Візуалізація забудовника: окремий котедж Stone Village з критим паркінгом на два авто" widths={[640, 960, 1280]} sizes="(max-width: 767px) 100vw, 50vw" format="webp" loading="lazy" /></figure>
        <div>
          <p class="kicker">Що варто знати</p>
          <h2 id="details-title" data-reveal>Продумано для спокою.</h2>
          <dl class="spec-list single">
            {[...cottageDetails, ...communityEngineering].map(item => <div><dt>{item.title}</dt><dd>{item.text}</dd></div>)}
          </dl>
        </div>
      </div>
    </section>

    <section class="residence-section" aria-labelledby="interior-title">
      <header class="residence-head">
        <p class="kicker">Інтер’єр</p>
        <h2 id="interior-title" data-reveal>Чистий аркуш на 228 м².</h2>
        <p data-reveal>Котедж передається з чорновим оздобленням. Висота, світло й площа дозволяють реалізувати інтер’єр без компромісів.</p>
      </header>
      <div class="interiors">
        <figure data-reveal="image"><Image src={stairs} alt="Візуалізація варіанта інтер’єру: вітальня зі сходами на другий поверх і кімнатними деревами" widths={[480, 800]} sizes="(max-width: 767px) 100vw, 40vw" format="webp" loading="lazy" /></figure>
        <figure data-reveal="image"><Image src={bedroom} alt="Візуалізація варіанта інтер’єру: спальня з дерев’яною стіною та м’яким узголів’ям" widths={[480, 800]} sizes="(max-width: 767px) 50vw, 32vw" format="webp" loading="lazy" /></figure>
        <figure data-reveal="image"><Image src={kids} alt="Візуалізація варіанта інтер’єру: дитяча кімната з м’яким ліжком і шафою" widths={[480, 800]} sizes="(max-width: 767px) 50vw, 24vw" format="webp" loading="lazy" /></figure>
      </div>
      <p class="interiors-note">Візуалізації показують можливий варіант оздоблення.</p>
    </section>

    <section class="evening" aria-labelledby="evening-title">
      <figure><Image src={evening} alt="Візуалізація забудовника: окремий котедж Stone Village увечері з підсвіченими вікнами" widths={[768, 1280, 1600]} sizes="100vw" format="webp" loading="lazy" /></figure>
      <div class="evening-copy">
        <h2 id="evening-title" data-reveal>Побачте свій майбутній вечір тут.</h2>
        <button class="cta cta--light" data-viewing-open data-reveal>{project.primaryAction}<span aria-hidden="true">↗</span></button>
      </div>
    </section>

    <ResidenceOffer product="cottage-228" />

    <aside class="village-link"><p>За межами ділянки — ліс, садочок, спорт і територія під доглядом керуючої компанії.</p><a class="arrow-link" href="/#care">Про безпеку й обслуговування <span aria-hidden="true">→</span></a></aside>
    <a class="other-residence" href="/duplex-185/">
      <figure><Image src={duplex} alt="" widths={[640, 960]} sizes="(max-width: 767px) 100vw, 40vw" format="webp" loading="lazy" /></figure>
      <div><p>Шукаєте компактніший формат?</p><strong>Дуплекс 185 м² <span aria-hidden="true">→</span></strong><span class="note">Кухня-вітальня 42 м², кабінет 22 м² і ділянка 4,5 сотки.</span></div>
    </a>
  </main>
  <SiteFooter inner />
  <MobileViewingBar />
  <ViewingDialog product="cottage-228" />
</SiteDocument>
<style>
  .opening-head { padding: 1rem var(--gutter) clamp(1.5rem, 3vw, 2.5rem); }
  .title-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; margin-top: clamp(1rem, 3vw, 2rem); }
  h1 { font-size: clamp(3rem, 6.5vw, 7.5rem); font-weight: 300; letter-spacing: -.055em; line-height: .95; }
  .area { font-size: clamp(7rem, 17vw, 17rem); white-space: nowrap; }
  .area small { font-size: .12em; letter-spacing: 0; margin-left: .4rem; font-weight: 400; }
  .opening-media { --progress: 0; position: relative; margin: 0; overflow: hidden; height: clamp(28rem, 72vh, 50rem); }
  .opening-media img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 52%; }
  :global(.motion) .opening-media img { transform: scale(calc(1 + var(--progress) * .1)); }
  .opening-intro { display: flex; justify-content: space-between; align-items: center; gap: 2rem 3rem; padding: 2rem var(--gutter) 0; }
  .opening-intro > p { font-size: clamp(1.125rem, 1.5vw, 1.375rem); max-width: 44ch; line-height: 1.45; }
  .opening-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 2rem; }

  .rarity { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--grid-gap); align-items: center; padding: var(--space-section) var(--gutter) 0; }
  .rarity figure { grid-column: 1 / span 7; margin: 0; overflow: hidden; }
  .rarity img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .rarity-copy { grid-column: 9 / span 4; }
  .rarity-count { display: flex; align-items: flex-end; gap: 1.25rem; color: var(--color-accent); }
  .rarity-count .numeral { font-size: clamp(8rem, 16vw, 16rem); line-height: .8; }
  .rarity-count span:last-child { font-size: .9375rem; line-height: 1.4; letter-spacing: .01em; padding-bottom: .5rem; }
  .rarity h2 { font-size: clamp(1.9rem, 2.8vw, 3rem); margin-top: 1.5rem; }
  .rarity-copy > p:last-child { margin-top: 1.5rem; color: var(--color-muted); font-size: 1.0625rem; }

  .yard { --progress: .5; position: relative; height: clamp(30rem, 90vh, 56rem); overflow: hidden; color: #fbf9f4; }
  .yard figure { position: absolute; inset: 0; margin: 0; }
  .yard img { width: 100%; height: 118%; object-fit: cover; object-position: 50% 60%; }
  :global(.motion) .yard img { transform: translateY(calc(-7.6% + (var(--progress) - .5) * -14%)); }
  .yard figure::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgb(16 15 13 / 70%), transparent 55%); }
  .yard-copy { position: absolute; left: var(--gutter); right: var(--gutter); bottom: clamp(2rem, 6vw, 5rem); display: flex; justify-content: space-between; align-items: flex-end; gap: 3rem; }
  .yard h2 { max-width: 12ch; font-weight: 300; }
  .yard p { max-width: 34ch; color: #e8e2d6; font-size: 1.0625rem; }

  .details-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--grid-gap); align-items: start; }
  .details-grid figure { grid-column: 1 / span 6; margin: 0; overflow: hidden; position: sticky; top: 6rem; }
  .details-grid figure img { width: 100%; aspect-ratio: 4 / 3.4; object-fit: cover; }
  .details-grid > div { grid-column: 8 / span 5; }
  .details-grid h2 { margin: 1.25rem 0 2rem; }
  .spec-list.single { grid-template-columns: 1fr; margin-top: 0; }
  .spec-list.single > div { grid-template-columns: 10rem 1fr; }

  .evening { position: relative; height: clamp(30rem, 90vh, 54rem); overflow: hidden; color: #fbf9f4; }
  .evening figure { position: absolute; inset: 0; margin: 0; }
  .evening img { width: 100%; height: 100%; object-fit: cover; object-position: 40% 60%; }
  .evening figure::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgb(16 15 13 / 70%), transparent 70%); }
  .evening-copy { position: absolute; left: var(--gutter); top: 50%; transform: translateY(-50%); max-width: 36rem; }
  .evening h2 { font-weight: 300; margin-bottom: 2rem; }
  .evening :focus-visible { outline-color: #fff; }

  @media (max-width: 64rem) {
    .opening-intro { flex-direction: column; align-items: flex-start; }
    .rarity figure { grid-column: 1 / -1; }
    .rarity-copy { grid-column: 1 / span 10; }
    .yard-copy { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .details-grid figure { grid-column: 1 / -1; position: relative; top: 0; }
    .details-grid > div { grid-column: 1 / -1; margin-top: 2rem; }
  }
  @media (max-width: 48rem) {
    .title-row { flex-direction: column; align-items: flex-start; gap: .5rem; }
    h1 { font-size: 3rem; }
    .area { font-size: clamp(6.5rem, 34vw, 9rem); }
    .opening-media { height: 26rem; }
    .opening-media img { object-position: 40% 50%; }
    .opening-intro > p { font-size: 1.0625rem; }
    .opening-actions, .opening-actions .cta { width: 100%; }
    .rarity { display: block; }
    .rarity figure { margin-inline: calc(-1 * var(--gutter)); margin-bottom: 2rem; }
    .rarity-count .numeral { font-size: 8rem; }
    .yard { height: 32rem; }
    .spec-list.single > div { grid-template-columns: 1fr; }
    .evening { height: 32rem; }
    .evening figure::after { background: linear-gradient(0deg, rgb(16 15 13 / 80%), transparent 80%); }
    .evening-copy { top: auto; bottom: 2rem; transform: none; right: var(--gutter); }
    .evening .cta { width: 100%; }
  }
</style>
