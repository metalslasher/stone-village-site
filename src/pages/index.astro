---
import SiteDocument from '@/layouts/SiteDocument.astro';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import SiteFooter from '@/components/navigation/SiteFooter.astro';
import HeroScene from '@/components/home/HeroScene.astro';
import SpaceStatement from '@/components/home/SpaceStatement.astro';
import EnvironmentStory from '@/components/home/EnvironmentStory.astro';
import ResidencesStory from '@/components/products/ResidencesStory.astro';
import InfrastructureStory from '@/components/home/InfrastructureStory.astro';
import CommunityCare from '@/components/home/CommunityCare.astro';
import ArchitectureStory from '@/components/home/ArchitectureStory.astro';
import RealVillage from '@/components/home/RealVillage.astro';
import ProjectGallery from '@/components/home/ProjectGallery.astro';
import VisitLocation from '@/components/home/VisitLocation.astro';
import FaqSection from '@/components/home/FaqSection.astro';
import VisitClosing from '@/components/home/VisitClosing.astro';
import ViewingDialog from '@/components/viewing/ViewingDialog.astro';
import MobileViewingBar from '@/components/viewing/MobileViewingBar.astro';
import { project } from '@/content/project';
---
<SiteDocument title="Stone Village — котеджне містечко біля лісу під Львовом" description={project.description} noindex>
  <SiteHeader />
  <main id="main" tabindex="-1">
    <HeroScene />
    <SpaceStatement />
    <EnvironmentStory />
    <ResidencesStory />
    <InfrastructureStory />
    <CommunityCare />
    <ArchitectureStory />
    <RealVillage />
    <ProjectGallery />
    <VisitLocation />
    <FaqSection />
    <VisitClosing />
  </main>
  <SiteFooter />
  <MobileViewingBar />
  <ViewingDialog />
</SiteDocument>
